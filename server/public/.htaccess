# SAKi Talk: 폴더 목록 숨기기, 내부 파일 직접 접근 막기
Options -Indexes
DirectoryIndex index.html
<FilesMatch "^(config-path)\.php$">
  Require all denied
</FilesMatch>
# 자동 배포(GitHub Actions)가 남기는 목록 파일
<FilesMatch "^(\.ftp-deploy-sync-state|deploy)\.json$">
  Require all denied
</FilesMatch>
# 웹앱 화면: 캐시는 짧게 (업데이트가 바로 보이도록). assets/ 의 파일은 이름에 해시가 붙어 오래 캐시해도 됨
<IfModule mod_headers.c>
  <FilesMatch "(\.(html|webmanifest)|^sw\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
# 화면 파일은 압축해서 보냄 (js·css 180KB → 57KB). api.php 의 JSON 은 압축하지 않는다:
# 응답 길이를 먼저 알려 주고 그 뒤에 알림·사키 일을 하는데, 압축하면 그 일이 끝날 때까지 앱이 기다리게 됨
<IfModule mod_deflate.c>
  <FilesMatch "\.(html|js|css|webmanifest|svg)$">
    SetOutputFilter DEFLATE
  </FilesMatch>
</IfModule>
